#!/bin/zsh
set -e

app_binary="/Applications/Gemini.app/Contents/MacOS/Gemini"

[[ -x "$app_binary" ]] || exit 1
/usr/bin/pgrep -x Gemini >/dev/null && exit 0

# Auto-detect mihomo mixed-port via API (falls back to 7890 if API unavailable)
SOCK="/var/run/clash-verge-service/users/501/verge-mihomo.sock"
if [ -S "$SOCK" ]; then
  MIXED_PORT=$(curl -s --max-time 2 --unix-socket "$SOCK" http://localhost/configs 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('mixed-port',7890))" 2>/dev/null || echo 7890)
else
  MIXED_PORT=7890
fi

# Verify the port is actually listening
/usr/bin/nc -z 127.0.0.1 "$MIXED_PORT" || { echo "Port $MIXED_PORT not listening. Is Clash Verge running?"; exit 1; }

proxy_http="http://127.0.0.1:$MIXED_PORT"
proxy_socks="socks5h://127.0.0.1:$MIXED_PORT"

# Gemini's gRPC stack only reads http_proxy/grpc_proxy env vars, not macOS system proxy
export HTTP_PROXY="$proxy_http" HTTPS_PROXY="$proxy_http" ALL_PROXY="$proxy_socks"
export http_proxy="$proxy_http" https_proxy="$proxy_http" all_proxy="$proxy_socks"
export GRPC_PROXY="$proxy_http" grpc_proxy="$proxy_http"
export NO_PROXY="localhost,127.0.0.1,::1" no_proxy="$NO_PROXY"

exec "$app_binary"
